# Include documentation and metadata files
include README.md
include LICENSE
include CHANGELOG.md
include requirements.txt
include pyproject.toml

# Include documentation directory
recursive-include docs *.md

# Include maintained examples without generated data or artifacts
recursive-include examples *.ipynb *.md
recursive-include creator_examples *.py *.ipynb *.md

# Include tests
recursive-include tests *.py

# Exclude compiled Python files
global-exclude *.py[cod]
global-exclude __pycache__
global-exclude *.so

# Exclude build artifacts
prune build
prune dist
prune *.egg-info
